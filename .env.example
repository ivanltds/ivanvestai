# ==========================================
# IvanvestAI - Configurações de Ambiente
# ==========================================

# Credenciais da Exchange (Binance)
EXCHANGE_ID=binance
BINANCE_API_KEY=sua_api_key_aqui
BINANCE_SECRET_KEY=sua_secret_key_aqui

# Parâmetros de DCA (Fase 1: DCA Puro)
# Símbolo do ativo (ex: BTC/BRL para comprar com Reais, ou BTC/USDT para comprar com Dólar)
DCA_SYMBOL=BTC/BRL

# Valor do aporte por execução na moeda base (ex: 50.00 para R$ 50,00 ou 10.00 para 10 USDT)
DCA_AMOUNT_FIAT=50.00

# Moeda usada para o aporte ('BRL' ou 'USDT')
DCA_CURRENCY=BRL

# Modo Simulação (DRY_RUN):
# Se True, calcula a ordem e gera logs reais SEM gastar dinheiro real na exchange.
# Se False, executa a compra real no mercado Spot.
DRY_RUN=true

# Configuração de Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Configura��o do LLM (Intelig�ncia Artificial)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Vercel KV (Redis) - Mem�ria do Bot
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...

#ENcode
PYTHONIOENCODING=utf-8