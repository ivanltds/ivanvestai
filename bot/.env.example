# --- SEGURANÇA DE CAPITAL ---
# true (padrão): NENHUMA ordem é enviada à Binance; entradas/saídas são simuladas
# (is_paper=true). Só mude pra false, editando este arquivo à mão, quando quiser
# operar com dinheiro real. Nunca é sobrescrito pelo dashboard, de propósito.
DRY_RUN=true

# --- Binance (subconta dedicada ao bot) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Restrinja essa key por IP fixo no painel da Binance.

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL_CHEAP=gpt-4o-mini
OPENAI_MODEL_ROBUST=gpt-4o

# --- Postgres (Vercel Postgres ou Neon) ---
DATABASE_URL=postgresql+psycopg://user:password@host:5432/ivanvestai

# --- Upstash Redis (REST API) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- E-mail (Gmail SMTP com senha de app) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
ALERT_EMAIL_TO=ivanltds@gmail.com

# --- Web Push (VAPID) ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:ivanltds@gmail.com

# --- Parâmetros gerais (também editáveis pela tela de configurações, que sobrescreve via tabela `settings`) ---
CYCLE_INTERVAL_MINUTES=15
ENTRY_DECISION_TIMEOUT_SECONDS=120
MIN_CONFIDENCE_TO_TRADE=0.80
MAX_ALLOCATION_PCT_PER_TRADE=0.50
DAILY_LOSS_ALERT_PCT=0.10
TOP_N_PAIRS=100
SAFETY_STABLECOIN=USDT
TIMEZONE=America/Sao_Paulo
# Revisão de posições pré-existentes: confiança mínima pra vender e intervalo mínimo entre revisões do mesmo ativo
MIN_CONFIDENCE_TO_EXIT=0.75
POSITION_REVIEW_INTERVAL_MINUTES=240

# Logs: arquivo diário em LOG_DIR (relativo a bot/) + tabela bot_logs no Postgres
LOG_DIR=logs
LOG_RETENTION_DAYS=30
LOG_TO_DB=true
