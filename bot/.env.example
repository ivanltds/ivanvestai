# --- SEGURANÇA DE CAPITAL ---
# true (padrão): NENHUMA ordem é enviada à Binance; entradas/saídas são simuladas
# (is_paper=true). Só mude pra false, editando este arquivo à mão, quando quiser
# operar com dinheiro real. Nunca é sobrescrito pelo dashboard, de propósito.
DRY_RUN=true

# --- Binance (subconta dedicada ao bot) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Restrinja essa key por IP fixo no painel da Binance.

# --- Multi-conta (opcional, ver multi-conta-plano.md) ---
# Chave de criptografia das credenciais das contas cadastradas via
# manage_accounts.py (nunca gravadas em texto plano no Postgres). Gere uma
# com: python -m core.crypto -- e cole o resultado aqui antes de rodar
# migrate_add_accounts.py ou manage_accounts.py add.
ACCOUNTS_ENCRYPTION_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL_CHEAP=gpt-4o-mini
OPENAI_MODEL_ROBUST=gpt-4o

# --- DeepSeek (opcional) ---
# Só é usado se FILTER_AGENT_PROVIDER=deepseek logo abaixo. Preencha a key
# ANTES de mudar o provider -- senão viability_agent/position_review_agent
# falham ao chamar a API (o bot trata isso como falha por oportunidade, não
# derruba o ciclo, mas o comitê fica sem esse filtro até você corrigir).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Provedor de LLM pros agentes-filtro (viability_agent, sua reconciliação e
# position_review_agent). "openai" (padrão, comportamento atual de hoje) ou
# "deepseek". O risk_committee_agent (decisão final, quem aprova mover
# capital real) SEMPRE fica em gpt-4o -- não é afetado por este flag. Troque
# à mão só depois de preencher DEEPSEEK_API_KEY acima.
FILTER_AGENT_PROVIDER=openai

# --- Postgres (Vercel Postgres ou Neon) ---
DATABASE_URL=postgresql+psycopg://user:password@host:5432/ivanvestai

# --- Upstash Redis (REST API) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- E-mail (Gmail SMTP com senha de app) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
ALERT_EMAIL_TO=ivanltds@gmail.com

# --- Web Push (VAPID) ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:ivanltds@gmail.com

# --- Parâmetros gerais (também editáveis pela tela de configurações, que sobrescreve via tabela `settings`) ---
CYCLE_INTERVAL_MINUTES=15
ENTRY_DECISION_TIMEOUT_SECONDS=120
MIN_CONFIDENCE_TO_TRADE=0.80
MAX_ALLOCATION_PCT_PER_TRADE=0.50
DAILY_LOSS_ALERT_PCT=0.10
TOP_N_PAIRS=100
SAFETY_STABLECOIN=USDT
TIMEZONE=America/Sao_Paulo
# Revisão de posições pré-existentes: confiança mínima pra vender e intervalo mínimo entre revisões do mesmo ativo
MIN_CONFIDENCE_TO_EXIT=0.75
POSITION_REVIEW_INTERVAL_MINUTES=240

# Logs: arquivo diário em LOG_DIR (relativo a bot/) + tabela bot_logs no Postgres
LOG_DIR=logs
LOG_RETENTION_DAYS=30
LOG_TO_DB=true

# Stop/take minimos (%) das posicoes NOVAS e monitor rapido de saida (segundos; 0 desliga)
MIN_STOP_LOSS_PCT=2.0
MIN_TAKE_PROFIT_PCT=4.0
RISK_MONITOR_SECONDS=60
