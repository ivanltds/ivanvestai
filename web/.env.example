# --- Postgres (mesmo banco usado pelo bot/) ---
DATABASE_URL=postgresql://user:password@host:5432/ivanvestai

# --- Upstash Redis (REST API) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth do dashboard ---
# OBRIGATÓRIO em produção, mínimo 32 caracteres (sem isso o login falha de propósito).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-longo-com-32-ou-mais-caracteres
# Magic link: reaproveita o SMTP do bot ou um provedor separado (ex: Resend) — a decidir na implementação.
MAGIC_LINK_EMAIL_FROM=ivanvestai@example.com

# --- Web Push (VAPID) — mesma chave pública usada pelo bot pra assinar ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
